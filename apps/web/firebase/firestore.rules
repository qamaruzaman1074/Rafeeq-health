rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

  // User profile and private subcollections (no genetic report payloads in demo).
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /consents/{consentId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }

      match /demoSession/{documentId} {
        allow read, write: if isOwner(userId);
      }
    }

  // Partnership exists only after both members join. Invitations do not grant data access.
    match /partnerships/{partnershipId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.memberUids;
      }

      function validMembers() {
        return request.resource.data.memberUids is list
          && request.resource.data.memberUids.size() == 2
          && request.resource.data.memberUids[0] is string
          && request.resource.data.memberUids[1] is string;
      }

      allow create: if signedIn()
        && validMembers()
        && request.auth.uid in request.resource.data.memberUids;
      allow read: if isMember();
      allow update: if isMember()
        && request.resource.data.memberUids == resource.data.memberUids;

      match /consentGrants/{categoryId} {
        allow read: if isMember();
        allow write: if isMember()
          && request.resource.data.granted is bool
          && request.resource.data.updatedBy == request.auth.uid;
      }

      match /sharingHistory/{eventId} {
        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

  // Invite metadata: inviter and invitee may see their row; accepting adds membership elsewhere.
    match /invitations/{inviteId} {
      function isInviter() {
        return signedIn() && resource.data.inviterUid == request.auth.uid;
      }

      function isInvitee() {
        return signedIn() && resource.data.inviteeUid == request.auth.uid;
      }

      allow create: if signedIn()
        && request.resource.data.inviterUid == request.auth.uid
        && request.resource.data.inviteeUid is string;
      allow read: if isInviter() || isInvitee();
      allow update: if isInviter() || isInvitee();
      allow delete: if isInviter();
    }

  // Read-only fictional fixtures for competition personas (admin-seeded).
    match /demoFixtures/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
