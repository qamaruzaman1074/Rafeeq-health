# --- Demo API (MSW) ---------------------------------------------------------
# Empty base URL keeps /api/v1 on the Vite origin while MSW is active.
# When Azure Functions product API is ready, set e.g.:
# VITE_API_BASE_URL=https://<your-fn-app>.azurewebsites.net
# Local Functions host (health only today): http://localhost:7071
VITE_API_BASE_URL=

# Set to true in local development to start the MSW worker for /api/v1.
VITE_USE_MOCKS=true

# --- Website assistant (server / Vercel only — never VITE_) -----------------
# GEMINI_API_KEY=
# GEMINI_FILE_SEARCH_STORE=fileSearchStores/...
# GEMINI_MODEL=gemini-2.5-flash
# ASSISTANT_DEV_PORT=8787

# --- Firebase (optional; next implementation phase) -------------------------
# Leave false (or unset) to run the competition demo without Firebase credentials.
VITE_USE_FIREBASE=false

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Supabase (browser-safe values only) ------------------------------------
# The publishable key is intended for browser use; protect data with RLS.
# Never put a Supabase secret/service_role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
